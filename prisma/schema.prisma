generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum PlanKind {
  MONTHLY
  DROP_IN
}

enum SlotKind {
  LESSON
  RENTAL
  EVENT
}

enum SlotStatus {
  OPEN
  CANCELED
}

enum ReservationStatus {
  RESERVED
  ATTENDED
  NO_SHOW
  CANCELED
}

/// 予約の種類。REGULAR=クラス在籍による通常出席、MAKEUP=振替
enum ReservationKind {
  NORMAL
  REGULAR
  MAKEUP
}

enum CreditStatus {
  AVAILABLE
  USED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model Staff {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(STAFF)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime  @default(now())
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions     Session[]
  resetTokens  PasswordResetToken[]
  slots        Slot[]               @relation("Instructor")
  classes      SchoolClass[]        @relation("Coach")
  payments     Payment[]
  auditLogs    AuditLog[]
  lineMessages LineMessage[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([staffId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Member {
  id         String       @id @default(cuid())
  memberNo   Int          @unique @default(autoincrement())
  lastName   String
  firstName  String
  lastKana   String?
  firstKana  String?
  email      String?      @unique
  phone      String?
  birthDate  DateTime?
  gender     String?
  status     MemberStatus @default(ACTIVE)
  planId     String?
  plan       Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  joinedAt   DateTime     @default(now())
  note       String?
  lineUserId String?      @unique
  externalId String?      @unique // 移行元（hacomono 等）の会員ID
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reservations Reservation[]
  payments     Payment[]
  sessions     MemberSession[]
  visits       Visit[]
  waitlists    Waitlist[]
  enrollments  Enrollment[]
  credits      MakeupCredit[]
  leaves       Leave[]
  invoices     Invoice[]
  guardianId   String? // 保護者（ジュニア会員の場合。保護者のLINE・会員ページで手続きする）
  guardian     Member?         @relation("Family", fields: [guardianId], references: [id], onDelete: SetNull)
  children     Member[]        @relation("Family")
}

model MemberSession {
  id        String   @id // sha256 of the cookie token
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  kind        PlanKind @default(MONTHLY)
  price       Int
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  members  Member[]
  payments Payment[]
  classes  SchoolClass[]
}

model Court {
  id             String   @id @default(cuid())
  name           String
  description    String?
  hourlyPrice    Int      @default(0)
  memberBookable Boolean  @default(true)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  slots   Slot[]
  classes SchoolClass[]
}

model Program {
  id          String   @id @default(cuid())
  name        String
  kind        SlotKind @default(LESSON)
  description String?
  capacity    Int      @default(8)
  durationMin Int      @default(60)
  price       Int      @default(0)
  color       String   @default("#2563eb")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  slots Slot[]
}

model Slot {
  id            String          @id @default(cuid())
  title         String
  kind          SlotKind        @default(LESSON)
  programId     String?
  program       Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  courtId       String
  court         Court           @relation(fields: [courtId], references: [id], onDelete: Restrict)
  instructorId  String?
  instructor    Staff?          @relation("Instructor", fields: [instructorId], references: [id], onDelete: SetNull)
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  price         Int             @default(0)
  status        SlotStatus      @default(OPEN)
  note          String?
  memberBooked  Boolean         @default(false) // 会員が時間を選んで予約したコート利用
  heldById      String? // 決済中の仮押さえ（会員ID）
  heldUntil     DateTime?
  publicEntries Boolean         @default(false) // 大会のエントリー一覧を会員ページに公開
  categories    EventCategory[]
  messages      EventMessage[]
  classId       String? // スクールの定期クラスの回
  schoolClass   SchoolClass?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  reservations Reservation[]

  @@unique([classId, startsAt])
  @@index([startsAt])
  @@index([courtId, startsAt])
}

model Reservation {
  id         String            @id @default(cuid())
  slotId     String
  slot       Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     ReservationStatus @default(RESERVED)
  kind       ReservationKind   @default(NORMAL)
  canceledAt DateTime?
  remindedAt DateTime?
  categoryId String?
  category   EventCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  teamName   String?
  players    String[]          @default([])
  createdAt  DateTime          @default(now())

  @@index([slotId])
  @@index([memberId])
}

model Payment {
  id                    String        @id @default(cuid())
  memberId              String?
  member                Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  planId                String?
  plan                  Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount                Int
  method                PaymentMethod @default(CASH)
  description           String
  paidAt                DateTime      @default(now())
  staffId               String?
  staff                 Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  reservationId         String?       @unique
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())

  @@index([paidAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  id                   Int     @id @default(1)
  facilityName         String  @default("48Kテニススクール")
  openHour             Int     @default(7)
  closeHour            Int     @default(23)
  cancelDeadlineHours  Int     @default(24)
  sessionHours         Int     @default(12)
  contactEmail         String?
  // スクール（定期クラス・欠席・振替）
  absenceDeadlineHours Int     @default(0) // 欠席連絡の期限（開始の何時間前まで。0=開始まで）
  makeupValidDays      Int     @default(60) // 振替の有効期限（欠席したレッスン日から何日）
  makeupLevelRule      String  @default("SAME_OR_LOWER") // SAME | SAME_OR_LOWER | ANY
  // 月謝
  admissionFee         Int     @default(0) // 入会金（初めての月謝に加算）
  leaveFee             Int     @default(0) // 休会費（休会中の月）
  prorateMidMonth      Boolean @default(true) // 月の途中の入会・退会は回数で按分
  facilityMode         Boolean @default(false) // 施設の予約・入退場（QR）を使う
  // 特定商取引法に基づく表記
  legalSeller          String?
  legalManager         String?
  legalAddress         String?
  legalPhone           String?
  legalEmail           String?
  legalNotes           String?
  // 利用規約・プライバシーポリシー（空なら既定の文面）
  termsText            String?
  privacyText          String?
}

model Visit {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  staffId    String?

  @@index([checkInAt])
  @@index([memberId, checkInAt])
}

enum EntryFormat {
  SINGLES
  DOUBLES
  TEAM
}

/// 大会の種目（形式×レベル）。定員は組数、参加費は1エントリーあたり
model EventCategory {
  id            String      @id @default(cuid())
  slotId        String
  slot          Slot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name          String
  format        EntryFormat @default(DOUBLES)
  level         String?
  teamSize      Int         @default(4)
  capacity      Int         @default(16)
  price         Int         @default(0)
  earlyPrice    Int? // 早期割引の参加費
  earlyUntil    DateTime? // 早期割引の締切（この時刻まで）
  drawPublished Boolean     @default(false) // 対戦表を会員ページに公開
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  reservations Reservation[]
  waitlist     Waitlist[]
  matches      Match[]

  @@index([slotId])
}

/// 大会参加者へのLINE一括連絡の履歴
model EventMessage {
  id         String   @id @default(cuid())
  slotId     String
  slot       Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  categoryId String?
  body       String
  sentCount  Int      @default(0)
  totalCount Int      @default(0)
  staffId    String?
  createdAt  DateTime @default(now())

  @@index([slotId, createdAt])
}

/// 満員の種目のキャンセル待ち
model Waitlist {
  id         String        @id @default(cuid())
  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([categoryId, memberId])
}

/// 対戦表の1試合。entryA/B と winner は Reservation.id
model Match {
  id          String        @id @default(cuid())
  categoryId  String
  category    EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stage       String // LEAGUE | KNOCKOUT
  groupName   String?
  round       Int
  position    Int
  entryAId    String?
  entryBId    String?
  score       String?
  winnerId    String?
  court       String?
  nextMatchId String?
  nextSlot    Int? // 0 = A, 1 = B
  createdAt   DateTime      @default(now())

  @@index([categoryId, stage, round, position])
}

/// スクールのレベル（rank が大きいほど上級）
model Level {
  id        String   @id @default(cuid())
  name      String
  rank      Int      @default(1)
  color     String   @default("#2563eb")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  classes SchoolClass[]
}

/// 毎週決まった曜日・時間に行う定期クラス。回（Slot）は月ごとなどにまとめて生成する
enum ClassTarget {
  ADULT
  JUNIOR
}

model SchoolClass {
  id          String      @id @default(cuid())
  name        String
  target      ClassTarget @default(ADULT) // 一般 / ジュニア（振替は同じ区分のクラスのみ）
  levelId     String?
  level       Level?      @relation(fields: [levelId], references: [id], onDelete: SetNull)
  weekday     Int // 0=日 … 6=土（JST）
  startTime   String // "HH:mm"
  durationMin Int         @default(90)
  courtId     String
  court       Court       @relation(fields: [courtId], references: [id], onDelete: Restrict)
  coachId     String?
  coach       Staff?      @relation("Coach", fields: [coachId], references: [id], onDelete: SetNull)
  planId      String? // 月謝（月額プラン）
  plan        Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  capacity    Int         @default(8)
  description String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  enrollments Enrollment[]
  slots       Slot[]
}

/// クラスへの在籍。startDate〜endDate（含む、JSTの日付の0時）の回に自動で出席予定が入る
model Enrollment {
  id          String      @id @default(cuid())
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime    @default(now())

  @@index([classId])
  @@index([memberId])
}

/// 振替の権利。欠席連絡・休講で発行し、振替予約で使う
model MakeupCredit {
  id                  String       @id @default(cuid())
  memberId            String
  member              Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status              CreditStatus @default(AVAILABLE)
  reason              String // 欠席連絡 / 休講 / 手動発行 など
  sourceReservationId String?      @unique // 欠席したレッスンの予約
  levelRank           Int? // 欠席したクラスのレベル（振替先の制限に使う）
  target              ClassTarget? // 欠席したクラスの区分（一般 / ジュニア）
  expiresAt           DateTime
  usedReservationId   String?      @unique // 振替で取った予約
  note                String?
  staffId             String?
  createdAt           DateTime     @default(now())

  @@index([memberId, status])
}

enum LineDirection {
  IN
  OUT
}

/// LINE公式アカウントの相手（友だち）。会員とは lineUserId で対応づける
model LineContact {
  id            String    @id @default(cuid())
  lineUserId    String    @unique
  displayName   String?
  pictureUrl    String?
  followed      Boolean   @default(true)
  needsReply    Boolean   @default(false) // 要対応
  unread        Int       @default(0)
  lastMessageAt DateTime?
  lastText      String?
  createdAt     DateTime  @default(now())

  messages LineMessage[]

  @@index([lastMessageAt])
}

/// LINEのやりとり（受信・自動応答・通知・スタッフの返信）
model LineMessage {
  id            String        @id @default(cuid())
  contactId     String
  contact       LineContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction     LineDirection
  type          String // text | image | sticker | file | postback | follow | unfollow | other
  text          String
  auto          Boolean       @default(false) // 自動応答・システム通知
  lineMessageId String?       @unique
  staffId       String?
  staff         Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([contactId, createdAt])
}

/// 休会（月単位。期間中は在籍クラスの出席予定が入らず、月謝の代わりに休会費）
model Leave {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fromMonth String // "YYYY-MM"
  toMonth   String // "YYYY-MM"（含む）
  reason    String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

/// 月謝の請求（会員×月）。lines は [{ label, amount }]
model Invoice {
  id        String        @id @default(cuid())
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  amount    Int
  lines     Json
  status    InvoiceStatus @default(UNPAID)
  paidAt    DateTime?
  paymentId String?       @unique
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([memberId, month])
  @@index([month, status])
}
