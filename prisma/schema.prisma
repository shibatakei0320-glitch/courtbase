generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum PlanKind {
  MONTHLY
  DROP_IN
}

enum SlotKind {
  LESSON
  RENTAL
  EVENT
}

enum SlotStatus {
  OPEN
  CANCELED
}

enum ReservationStatus {
  RESERVED
  ATTENDED
  NO_SHOW
  CANCELED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model Staff {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(STAFF)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime  @default(now())
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]
  slots       Slot[]               @relation("Instructor")
  payments    Payment[]
  auditLogs   AuditLog[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([staffId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Member {
  id        String       @id @default(cuid())
  memberNo  Int          @unique @default(autoincrement())
  lastName  String
  firstName String
  lastKana  String?
  firstKana String?
  email     String?      @unique
  phone     String?
  birthDate DateTime?
  gender    String?
  status    MemberStatus @default(ACTIVE)
  planId    String?
  plan      Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  joinedAt  DateTime     @default(now())
  note      String?
  lineUserId String?     @unique
  externalId String?     @unique // 移行元（hacomono 等）の会員ID
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  reservations Reservation[]
  payments     Payment[]
  sessions     MemberSession[]
  visits       Visit[]
  waitlists    Waitlist[]
}

model MemberSession {
  id        String   @id // sha256 of the cookie token
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  kind        PlanKind @default(MONTHLY)
  price       Int
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  members  Member[]
  payments Payment[]
}

model Court {
  id          String   @id @default(cuid())
  name        String
  description String?
  hourlyPrice    Int     @default(0)
  memberBookable Boolean @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  slots Slot[]
}

model Program {
  id          String   @id @default(cuid())
  name        String
  kind        SlotKind @default(LESSON)
  description String?
  capacity    Int      @default(8)
  durationMin Int      @default(60)
  price       Int      @default(0)
  color       String   @default("#2563eb")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  slots Slot[]
}

model Slot {
  id           String     @id @default(cuid())
  title        String
  kind         SlotKind   @default(LESSON)
  programId    String?
  program      Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  courtId      String
  court        Court      @relation(fields: [courtId], references: [id], onDelete: Restrict)
  instructorId String?
  instructor   Staff?     @relation("Instructor", fields: [instructorId], references: [id], onDelete: SetNull)
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  price        Int        @default(0)
  status       SlotStatus @default(OPEN)
  note         String?
  memberBooked Boolean    @default(false) // 会員が時間を選んで予約したコート利用
  heldById     String? // 決済中の仮押さえ（会員ID）
  heldUntil    DateTime?
  publicEntries Boolean   @default(false) // 大会のエントリー一覧を会員ページに公開
  categories   EventCategory[]
  messages     EventMessage[]
  createdAt    DateTime   @default(now())

  reservations Reservation[]

  @@index([startsAt])
  @@index([courtId, startsAt])
}

model Reservation {
  id          String            @id @default(cuid())
  slotId      String
  slot        Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      ReservationStatus @default(RESERVED)
  canceledAt  DateTime?
  remindedAt  DateTime?
  categoryId  String?
  category    EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  teamName    String?
  players     String[]       @default([])
  createdAt   DateTime          @default(now())

  @@index([slotId])
  @@index([memberId])
}

model Payment {
  id          String        @id @default(cuid())
  memberId    String?
  member      Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  planId      String?
  plan        Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount      Int
  method      PaymentMethod @default(CASH)
  description String
  paidAt      DateTime      @default(now())
  staffId     String?
  staff       Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  reservationId         String? @unique
  refundedAt            DateTime?
  createdAt   DateTime      @default(now())

  @@index([paidAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  id                  Int     @id @default(1)
  facilityName        String  @default("CourtBase")
  openHour            Int     @default(7)
  closeHour           Int     @default(23)
  cancelDeadlineHours Int     @default(24)
  sessionHours        Int     @default(12)
  contactEmail        String?
  facilityMode        Boolean @default(false) // 施設の予約・入退場（QR）を使う
  // 特定商取引法に基づく表記
  legalSeller         String?
  legalManager        String?
  legalAddress        String?
  legalPhone          String?
  legalEmail          String?
  legalNotes          String?
  // 利用規約・プライバシーポリシー（空なら既定の文面）
  termsText           String?
  privacyText         String?
}

model Visit {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  staffId    String?

  @@index([checkInAt])
  @@index([memberId, checkInAt])
}

enum EntryFormat {
  SINGLES
  DOUBLES
  TEAM
}

/// 大会の種目（形式×レベル）。定員は組数、参加費は1エントリーあたり
model EventCategory {
  id        String      @id @default(cuid())
  slotId    String
  slot      Slot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name      String
  format    EntryFormat @default(DOUBLES)
  level     String?
  teamSize  Int         @default(4)
  capacity  Int         @default(16)
  price     Int         @default(0)
  earlyPrice Int?       // 早期割引の参加費
  earlyUntil DateTime?  // 早期割引の締切（この時刻まで）
  drawPublished Boolean @default(false) // 対戦表を会員ページに公開
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  reservations Reservation[]
  waitlist     Waitlist[]
  matches      Match[]

  @@index([slotId])
}

/// 大会参加者へのLINE一括連絡の履歴
model EventMessage {
  id         String   @id @default(cuid())
  slotId     String
  slot       Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  categoryId String?
  body       String
  sentCount  Int      @default(0)
  totalCount Int      @default(0)
  staffId    String?
  createdAt  DateTime @default(now())

  @@index([slotId, createdAt])
}

/// 満員の種目のキャンセル待ち
model Waitlist {
  id         String        @id @default(cuid())
  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([categoryId, memberId])
}

/// 対戦表の1試合。entryA/B と winner は Reservation.id
model Match {
  id         String        @id @default(cuid())
  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stage      String        // LEAGUE | KNOCKOUT
  groupName  String?
  round      Int
  position   Int
  entryAId   String?
  entryBId   String?
  score      String?
  winnerId   String?
  court      String?
  nextMatchId String?
  nextSlot   Int?          // 0 = A, 1 = B
  createdAt  DateTime      @default(now())

  @@index([categoryId, stage, round, position])
}
