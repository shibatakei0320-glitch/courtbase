DATABASE_URL_UNPOOLED="postgresql://app:app@localhost:5432/courtbase?schema=public"

# 会員ログイン（LINE Developers の LINE Login チャネル）
# LINE_CHANNEL_ID=""
# LINE_CHANNEL_SECRET=""
# LINE公式アカウント（Messaging API チャネル）：通知・受信箱・トークからの欠席連絡／振替予約
# Webhook URL は {APP_URL}/api/line/webhook。LINEログインのチャネルと同じプロバイダーに作成すること
# LINE_MESSAGING_TOKEN=""   # チャネルアクセストークン（長期）
# LINE_MESSAGING_SECRET=""  # チャネルシークレット（Webhookの署名検証）
# オンライン決済（Stripe）
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
